# Optional - everything works offline without these.
# Remote speech-to-text (--engine api) and LLM analysis (--llm) via any OpenAI-compatible server.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VOICENOTES_CHAT_MODEL=gpt-4o-mini
VOICENOTES_STT_MODEL=whisper-1
# Local whisper model size for faster-whisper / openai-whisper (tiny, base, small, medium, large-v3)
VOICENOTES_WHISPER_MODEL=base
